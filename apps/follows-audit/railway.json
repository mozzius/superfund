{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/apps/follows-audit/**",
      "/packages/labeller-client/**",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm -F follows-audit start",
    "restartPolicyType": "ON_FAILURE",
    "limitOverride": {
      "containers": {
        "memoryBytes": 500000000
      }
    },
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
