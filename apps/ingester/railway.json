{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/ingester/**",
      "/packages/labeller-client/**",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm -F ingester start",
    "restartPolicyType": "ON_FAILURE"
  }
}
