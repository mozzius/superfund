{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/labeller/**",
      "/packages/labeller-client/**",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm -F labeller start",
    "restartPolicyType": "ON_FAILURE",
    "drainingSeconds": 15
  }
}
