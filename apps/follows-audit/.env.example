# Points at the labeller's INTERNAL server (not the public labeler port).
LABELLER_URL=http://localhost:14832
INTERNAL_API_KEY=
# AUDIT_DB_PATH=./audit.db
# JETSTREAM_ENDPOINT=

# Discovery: each takedown gives a hit to its TAKEDOWN_FANOUT most recent
# followers; accounts with MIN_HITS hits get their follows audited.
# TAKEDOWN_FANOUT=1000
# MIN_HITS=3
# COOLDOWN_HOURS=24
# CANDIDATE_TTL_DAYS=14
# MAX_PENDING_TAKEDOWNS=50000

# Audit
# FOLLOWS_SAMPLE_SIZE=1000
# MIN_COUNTED=50
# RELABEL_DAYS=14
# LABEL_EXPIRY_DAYS=30
# WORKER_CONCURRENCY=2

# Requests per second per upstream. Constellation is a community-run service; keep it low.
# CONSTELLATION_RPS=2
# APPVIEW_RPS=5
# RELAY_RPS=10
# PLC_RPS=5
# PDS_RPS=5  (per PDS host)
# Internal JSON for the labeller dashboard (Railway private network only).
# PORT=14833
